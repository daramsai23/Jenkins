    agent any
    stages {
        stage("firststage") {
            steps {
                echo "Hello from First Stage"
            }
        }
        stage("secondstage") {
            steps {
                echo "Hello from Second Stage"
            }
        }
        stage("Thirdstage") {
            steps {
                echo "Hello from Third Stage"
            }
        }
    }
}